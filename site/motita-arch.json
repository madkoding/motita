      "title": "Clients",
      "items": [
        "Terminal TUI with ANSI wordmark and plan/task tabs",
        "Web UI with holographic doodle background and Markdown rendering",
        "Both share one gateway with bearer-token auth and origin policy"
      ]
    },
    {
      "dot": "emerald",
      "title": "Orchestration",
      "items": [
        "App wires config, session, gateway, and the agent loop",
        "Plan resolves the embedded soul + operational prompt",
        "Agent calls any OpenAI-compatible LLM and executes in the sandbox"
      ]
    },
    {
      "dot": "rose",
      "title": "Guardrails",
      "items": [
        "Policy gates every action: allow, ask, or deny",
        "Sandbox isolates execution with rlimits and ephemeral dirs",
        "Anchor validates exit codes and invariants \u2014 nothing runs unjudged",
        "Net rules enforce origin policy on gateway requests"
      ]
    }
  ]
