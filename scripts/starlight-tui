#!/bin/sh
# starlight-tui — open the starlight chat against a fixed configuration and credential file.
#
# Usage:
#   starlight                       # interactive chat
#   starlight -task "x"             # one-shot task
#   starlight -p "x"                # one-shot plan/chat prompt
#   starlight -validate-config      # check the configuration and exit
#   CONFIG=/path/to.yaml starlight  # a different configuration
#
# Why a wrapper and not just the binary:
#
#   The API key is not stored in the configuration file — the loader reads it
#   from STARLIGHT_LLM_API_KEY, or from the provider's own variable
#   (OLLAMA_API_KEY for Ollama Cloud). Sourcing the credential file here keeps
#   the key in exactly one place instead of in every shell that runs the agent.
#
#   The configuration path is passed explicitly so neither the current
#   directory nor HOME decides which file is read, which is what makes the
#   same command work from anywhere.
#
#   And it asks for the chat. The binary treats "-config FILE" with no other
#   flags as "run the configured task source", which is deliberate — cron jobs
#   and CI depend on it — so passing a configuration is enough to turn the
#   invocation into a batch run and print structured logs to the terminal.
#   Here the intent is the opposite: the user typed the name of a chat client
#   with nothing else, so the wrapper says -tui unless the arguments already
#   spell out a different job.
#
# Defaults, in order of precedence:
#   CONFIG      env var, else <repo>/.starlight/starlight.yaml
#   ENV_FILE    env var, else <repo>/.starlight/env
#   BINARY      env var, else <repo>/bin/starlight-fk
#
# Everything after the wrapper's own name is forwarded verbatim to the binary.

set -e

# Locate this script as the file it really is, not as the name it was invoked by.
#
# The wrapper is meant to be linked onto PATH, and a link is what gets run:
#
#   ~/bin/starlight -> <repo>/bin/starlight-tui -> <repo>/scripts/starlight-tui
#
# Taking dirname($0) at face value resolves to the directory the LINK lives in,
# so the wrapper would look for the configuration and the binary next to the
# link — in ~/bin, or in ~ itself — instead of in the repository. Following the
# chain to the real file is what makes the same command work from a link, from
# the repository, and from any working directory.
#
# A bare name ($0 = "starlight", with no slash) is resolved through PATH first,
# because that is the other shape a shell can hand over.
case $0 in
    */*) SELF=$0 ;;
    *)   SELF=$(command -v -- "$0" 2>/dev/null || echo "$0") ;;
esac

# The bound is not decoration: a link cycle would otherwise loop forever.
hops=0
while [ -L "$SELF" ]; do
    hops=$((hops + 1))
    if [ "$hops" -gt 40 ]; then
        echo "starlight-tui: too many symbolic links resolving $0" >&2
        exit 2
    fi
    target=$(readlink "$SELF") || exit 2
    case $target in
        /*) SELF=$target ;;
        *)  SELF=$(dirname "$SELF")/$target ;;
    esac
done

HERE=$(cd "$(dirname "$SELF")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)

CONFIG=${CONFIG:-"$ROOT/.starlight/starlight.yaml"}
ENV_FILE=${ENV_FILE:-"$ROOT/.starlight/env"}
BINARY=${BINARY:-"$ROOT/bin/starlight-fk"}

if [ ! -x "$BINARY" ]; then
    echo "starlight-tui: binary not found or not executable: $BINARY" >&2
    echo "  build it with: go build -trimpath -ldflags '-s -w' -o bin/starlight-fk ./cmd/agent" >&2
    exit 2
fi

if [ ! -f "$CONFIG" ]; then
    echo "starlight-tui: configuration not found: $CONFIG" >&2
    echo "  create it with: starlight -init" >&2
    exit 2
fi

# The credential file is optional: an environment that already exports the key
# does not need one, and requiring it would break that case. When it is there,
# it wins, because the file is the more specific instruction.
if [ -f "$ENV_FILE" ]; then
    # shellcheck disable=SC1090
    . "$ENV_FILE"
fi

# Decide whether to ask for the chat.
#
# The rule is the one a user would state: if every argument is a flag, the user
# asked for nothing in particular and wants the interface; the moment an
# argument names a job — a task, a task file, a prompt, or one of the diagnostic
# modes — that job is what runs, and the interface would swallow its output.
#
# The list of flags that consume the NEXT argument matters: without it,
# "-task count the files" would leave "count" looking like a job of its own and
# the decision would still come out right by accident, while "-config x" would
# leave "x" looking like one and would not. Both are spelled out.
wants_tui=true
expect_value=false
for arg in "$@"; do
    if [ "$expect_value" = true ]; then
        expect_value=false
        continue
    fi
    case $arg in
        # Flags that take the following word as their value.
        -config|--config|-task|--task|-task-file|--task-file|-p|--prompt)
            expect_value=true
            case $arg in
                -task|--task|-task-file|--task-file|-p|--prompt) wants_tui=false ;;
            esac
            ;;
        # The single-word modes: each produces its own output.
        -validate-config|--validate-config|-isolation|--isolation|\
        -version|--version|-init|--init|-h|-help|--help)
            wants_tui=false
            ;;
        # "-flag=value" carries its value inline, so it never consumes the next word.
        -*=*)
            case ${arg%%=*} in
                -task|--task|-task-file|--task-file|-p|--prompt|\
                -validate-config|--validate-config|-isolation|--isolation|\
                -version|--version|-init|--init|-h|-help|--help)
                    wants_tui=false
                    ;;
            esac
            ;;
        # A bare word: something to do.
        -*)
            : # an unknown flag; the binary will report it
            ;;
        *)
            wants_tui=false
            ;;
    esac
done

if [ "$wants_tui" = true ]; then
    exec "$BINARY" -config "$CONFIG" -tui "$@"
fi
exec "$BINARY" -config "$CONFIG" "$@"
