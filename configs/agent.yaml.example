# starlight — complete example configuration
#
# Every value shown is what the agent applies when the key is omitted, so this
# file doubles as documentation and as a template.
#
# Validate without running anything (does not call the LLM):
#     starlight-agent -config configs/agent.yaml.example -validate-config
#
# Every scalar setting can be overridden with a STARLIGHT_<BLOCK>_<FIELD>
# environment variable (see README.md). The lists and maps (task_source.headers,
# anchor.args, anchor.checks) are set here. Credentials must NEVER live in this
# file: use STARLIGHT_LLM_API_KEY or OPENAI_API_KEY.
# graceful_shutdown_timeout also accepts the older name of the previous release:
# STARLIGHT_AGENT_SHUTDOWN_TIMEOUT.

# ---------------------------------------------------------------------------
# Task source
# ---------------------------------------------------------------------------
task_source:
  kind: stdin          # stdin | file | api | queue
  # kind=file: a file holding the task (plain text)
  path: ""
  # kind=queue: directory files are taken from in alphabetical order; once
  # processed they are renamed to .done
  dir: ""
  # kind=api: the URL is polled; 'field' says where the task is in the response
  url: ""
  method: GET          # GET | POST
  field: task
  interval: 30s        # polling for api/queue
  headers:
    Accept: application/json
  body: ""             # request body for POST

# ---------------------------------------------------------------------------
# Layer A — THE ANCHOR (deterministic validator)
# ---------------------------------------------------------------------------
anchor:
  kind: command        # command | none
  command: make        # run as is, with no reasoning
  args: [test]
  timeout: 120s
  expect_exit: 0       # exit code that means PASS
  expect_output: ""    # optional regular expression over the output
  # Extra checks: EVERY one of them must pass for the anchor to give PASS.
  checks:
    - name: formatting
      command: gofmt
      args: ["-l", "."]
      timeout: 30s
      expect_exit: 0
      expect_output: "^$"   # gofmt prints nothing when everything is formatted

# ---------------------------------------------------------------------------
# Layer C — THE SANDBOX (isolated execution, no Docker)
# ---------------------------------------------------------------------------
sandbox:
  kind: cgroups        # none | chroot | cgroups
  # kind=chroot: chroot root (requires root, and the command must exist inside
  # the root)
  root: ""
  # Drop privileges inside the sandbox (uid:gid); requires root
  user: ""
  memory_mb: 512
  cpu_seconds: 60
  processes: 128
  open_files: 256
  max_file_size_mb: 64
  isolate_network: false   # true = own network namespace (no network)
  cgroups: auto        # auto | on | off   (v1: memory + pids)
  cgroup_root: /sys/fs/cgroup
  timeout: 300s
  keep_ephemeral: false   # true = do not delete the attempt's temp directory
  max_output_kb: 256

# ---------------------------------------------------------------------------
# Layer B — THE REASONING ENGINE
# ---------------------------------------------------------------------------
llm:
  provider: openai     # openai | anthropic | gemini
  model: gpt-4o-mini
  api_key: ""          # BETTER: export STARLIGHT_LLM_API_KEY
  base_url: https://api.openai.com/v1   # any compatible gateway works
  max_tokens: 2048
  temperature: 0.2
  timeout: 90s
  max_attempts: 3      # retries with exponential backoff on 429/5xx/network
  backoff_initial: 1s
  backoff_max: 30s

# ---------------------------------------------------------------------------
# Prompt templates. Available variables:
#   {{task}} {{workspace}} {{origin}} {{attempt}} {{max_attempts}} {{rules}}
#   {{analysis}} {{plan}} {{history}} {{model}} {{provider}} {{context_*}}
# ---------------------------------------------------------------------------
prompts:
  analyze:
    system: |
      You are Layer B (the reasoning engine) of an agent with deterministic
      validation. Reply only with the requested JSON.
    user: |
      ## TASK
      {{task}}

      ## VALIDATION RULES THAT WILL BE APPLIED
      {{rules}}

      Return JSON: {"understandable": bool, "summary": "...",
                    "success_criteria": ["..."], "risks": ["..."],
                    "needs_subtasks": bool}
  plan:
    system: |
      You are Layer B. Reply only with the requested JSON.
    user: |
      ## TASK
      {{task}}

      ## PREVIOUS ANALYSIS
      {{analysis}}

      Return JSON: {"plan": [{"step": 1, "action": "...", "command": "..."}],
                    "subtasks": ["..."], "expected_result": "..."}
  execute:
    system: |
      You are Layer B. Reply only with the requested JSON.
    user: |
      ## TASK
      {{task}}

      ## PLAN
      {{plan}}

      {{history}}

      Return JSON: {"reasoning": "...",
                    "actions": [{"kind": "command", "description": "...",
                                 "command": "..."}],
                    "final_action": {"description": "...", "command": "..."}}
      If an attempt failed before, correct it from the records.

# ---------------------------------------------------------------------------
# What to do when the anchor gives PASS
# ---------------------------------------------------------------------------
final_action:
  kind: git_commit     # none | command | api | git_commit
  command: ""          # kind=command
  args: []
  url: ""              # kind=api: POSTs {task, command, status:"pass"}
  method: POST
  commit_message: "agent: {{task}}"

# ---------------------------------------------------------------------------
# Main loop, logging and shutdown
# ---------------------------------------------------------------------------
agent:
  max_retries: 3               # total attempts = max_retries + 1
  subtask_depth: 1             # allowed splitting levels
  max_tasks: 0                 # 0 = no limit
  workspace_dir: ./workspace
  log_file: ./workspace/starlight.log   # empty = console only
  log_level: info              # debug | info | warn | error
  log_console: true
  log_max_mb: 5                # size-based rotation
  log_backups: 3
  graceful_shutdown_timeout: 15s
  # Failure action, run when a task runs out of retries without passing.
  # It runs inside the sandbox and leaves a trace for someone to review.
  on_failure:
    kind: command              # none | command
    command: 'echo "task not resolved: check the log" >> escalations.log'

# ---------------------------------------------------------------------------
# Gateway: the HTTP face of the agent.
#
# On by default and bound to loopback, behind a token kept in a file under the
# starlight home. That combination is what lets a second front end - a web page,
# a phone - reach the SAME conversation the terminal is having: the agent lives
# once, in the process that runs the gateway, and every interface is a client.
#
# Reaching it from another machine takes two deliberate acts: a non-loopback
# listen address AND allow_lan. The thing being exposed runs commands on this
# machine, so neither a default nor a single flag may do it alone.
#
# There is NO TLS in this version. The supported way to reach a gateway on
# another machine is a tunnel, which never exposes it at all:
#
#     ssh -N -L 8787:127.0.0.1:8787 the-host
#     # then point the client at http://127.0.0.1:8787
#
# Exposing it on a LAN without a tunnel sends the token in clear text. That is a
# decision, not an accident: it is loud in the log, and allow_lan is what asks
# for it.
gateway:
  enabled: true
  # host:port. A FIXED port by default, because `starlight gateway start` runs the
  # gateway as a service that a later process has to find: an ephemeral port exists
  # only in the memory of the process that asked for it, so nothing else can reach
  # it. `starlight` with no arguments reuses a running gateway, or starts its own.
  listen: "127.0.0.1:7477"
  # Where the bearer token lives. Generated on first use, 0600, under the home.
  token_file: "gateway.token"
  # Must be true for any address that is not loopback.
  allow_lan: false
  # Cap on a request body, in KB.
  max_body_kb: 256
  # How many conversations this process will hold at once. 0 means the built-in
  # default. The ceiling exists so a client that forgets to close what it opened
  # cannot turn the agent into a memory leak.
  max_sessions: 0
  # Serve the browser interface from this same port. The page and the API share an
  # origin, so there is no second server to run and no CORS to negotiate. The page
  # itself is served without a token - it holds no secret, and it is the only way a
  # browser can obtain one - and the token is exchanged for a cookie whose value is
  # DERIVED from it, so what a browser stores is not a reusable credential.
  #
  # Off means an API-only gateway, which is a real deployment: a script that drives
  # the agent has no use for a page.
  webui: true
