# Build artefacts
/dist/
/starlight
/starlight-linux-*
agent_i386
/chat
/chat.exe

# Cross-compiled binaries for fuchikoma (the host where the agent lives)
/bin/

# Local mock OpenAI used during fuchikoma bring-up; not part of the starlight binary
/tools/textmock/

# Environment and secrets
.env
*.local

# Editors
.idea/
.vscode/
*.swp
.DS_Store

# Test artefacts
coverage.out
.e2e/

# Runtime directories (the default workspace_dir and log_file are relative)
workspace/

# Third-party reference material, not ours to publish
#
# The TUI design skill (github.com/pageton/tui-design-skill) ships no license, so
# it is all rights reserved. A copy is kept locally for consultation, but it must
# not be redistributed from this MIT repository. Its lessons were re-written in
# our own words in the go-i386-openai-agent skill instead.
/.skill-tui-design/
