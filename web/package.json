{
  "name": "motita-webui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/__tests__/*.test.mjs",
    "test:coverage": "mkdir -p coverage && node --test --enable-source-maps --experimental-test-coverage --test-coverage-exclude='**/node_modules/**' --test-coverage-exclude='src/__tests__/**' --test-reporter=lcov --test-reporter-destination=coverage/lcov.info --test-reporter=dot --test-reporter-destination=stdout src/__tests__/*.test.mjs",
    "typecheck": "tsc --noEmit -p .",
    "format": "prettier --write src",
    "format:check": "prettier --check src"
  },
  "dependencies": {
    "@diffusionstudio/piper-wasm": "1.0.0",
    "@huggingface/tokenizers": "0.2.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "markdown-it": "^15.0.2",
    "markdown-it-deflist": "^4.0.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-github-alerts": "^1.0.1",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^12.2.0",
    "onnxruntime-web": "1.30.0",
    "preact": "^11.0.0",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "overrides": {
    "lodash-es": "^4.18.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.9.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "postcss": "^8.5.29",
    "prettier": "3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
